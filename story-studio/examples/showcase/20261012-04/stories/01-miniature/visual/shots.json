      ],
      "newInformation": "刀压下时外皮未破，内层先受压变形。",
      "visualRole": "微缩剖面把外皮阻挡和内层挤压放在同一动作里。"
    },
    {
      "id": "u02",
      "sentenceIds": [
        "s002"
      ],
      "newInformation": "切穿后细雾先喷出，较大液滴随后出现。",
      "visualRole": "用颗粒尺寸与出场时序表现先雾后液滴。"
    },
    {
      "id": "u03",
      "sentenceIds": [
        "s003"
      ],
      "newInformation": "含硫刺激物随空气扩散，液滴可作载体。",
      "visualRole": "浅色雾滴与暖色刺激物并行移动，避免把两者画成同一物。"
    },
    {
      "id": "u04",
      "sentenceIds": [
        "s004"
      ],
      "newInformation": "实验中更快或更钝会增加喷滴；锋利轻缓可减少。",
      "visualRole": "先显出实验里的快切/钝刀，再切到慢/锋利的建议动作；同一句内拆镜，不漏掉两层意思。"
    }
  ],
